# ==============================================================================
# GUARDIAN CFO - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and frontend/.env.local or refer to docs/INSTALLATION_GUIDE.md

# --- BACKEND (FastAPI & Database) ---
PROJECT_NAME="Guardian CFO"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database: SQLite for local zero-config dev, or PostgreSQL for production
DATABASE_URL="sqlite:///./guardian_cfo.db"
# DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/guardian_cfo"

# AI CFO LLM (Optional - automatic high-performance deterministic fallback if omitted)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# PayPal REST API Credentials (Developer Sandbox)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Governance & Safety Limits (USD)
AUTO_APPROVE_THRESHOLD_USD=250.00
CRITICAL_RISK_THRESHOLD=75.0

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

