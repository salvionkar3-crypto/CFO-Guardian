# ==============================================================================
# GUARDIAN CFO - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project & Runtime Environment
PROJECT_NAME="Guardian CFO"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Allowed CORS Origins (Frontend Dev Server)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Connection URL
# Production Standard: PostgreSQL (psycopg3)
# e.g., postgresql+psycopg://postgres:your_password@localhost:5432/guardian_cfo
# Zero-config Local Development: SQLite
DATABASE_URL="sqlite:///./guardian_cfo.db"

# OpenAI API Key (For structured AI reasoning & tool-calling agent)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# PayPal REST API Credentials (Developer Sandbox)
# Get your credentials at: https://developer.paypal.com/dashboard/applications/sandbox
# Mode can be "sandbox" or "live"
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# Financial Policy Guardrails (USD)
AUTO_APPROVE_THRESHOLD_USD=250.00
CRITICAL_RISK_THRESHOLD=75.0

